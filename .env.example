# Copie para .env (desenvolvimento local) e/ou cadastre na Vercel em Settings → Environment Variables.
# NUNCA versione o arquivo .env.

# Conexão Postgres do Supabase — use a string do "Transaction pooler" (porta 6543).
# Na Vercel, a integração oficial do Supabase cria POSTGRES_URL automaticamente; nesse caso DATABASE_URL é dispensável.
DATABASE_URL=postgres://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave mestra que protege a chave de criptografia de cada clínica (64 caracteres hexadecimais).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE UMA CÓPIA EM LOCAL SEGURO: sem ela os prontuários não podem ser lidos.
MASTER_KEY=

# Endereço público do sistema (usado nos retornos do Stripe)
APP_URL=http://localhost:3000

# Stripe (deixe vazio para desativar a assinatura on-line)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (opcional; também pode ser configurado no painel /admin → APIs)
MP_ACCESS_TOKEN=
MP_PRICE=
MP_WEBHOOK_SECRET=

# E-mail (opcional; também pode ser configurado no painel /admin → APIs)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=

# Segredo do cron diário da Vercel (limpeza de sessões vencidas) e do agendador dos lembretes do WhatsApp.
# Lembretes: um agendador externo (ex.: cron-job.org) chama GET /api/cron/whatsapp a cada 5 minutos
# com o cabeçalho  Authorization: Bearer <CRON_SECRET>  (o plano Hobby da Vercel só roda cron 1 vez por dia).
# O servidor e a chave da Evolution API ficam no painel /admin → Configurações → WhatsApp (Evolution API).
CRON_SECRET=

# Código para criar o primeiro administrador da plataforma em /admin (pode ser removido depois)
ADMIN_SETUP_TOKEN=

# Opcionais
# TRIAL_DAYS=7
# PG_POOL_MAX=3
